{
  "name": "masa-ha-nikud",
  "version": "1.0.3",
  "private": true,
  "description": "מסע הניקוד - משחק שולחן לימודי לתרגול ניקוד עברי",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "npm run qa && tsc && vite build",
    "preview": "vite preview",
    "desktop": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win nsis",
    "validate:content": "node scripts/validate-content.mjs",
    "check": "npm run validate:content && tsc --noEmit",
    "validate:release": "node scripts/validate-release.mjs",
    "qa": "npm run validate:content && npm run validate:release"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "^37.2.3",
    "electron-builder": "^26.0.12",
    "typescript": "^5.8.3",
    "vite": "^7.0.4"
  },
  "build": {
    "appId": "il.co.maftehot.masa-hanikud",
    "productName": "מסע הניקוד",
    "directories": {"output": "release", "buildResources": "build"},
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "win": {"target": ["nsis"], "icon": "build/icon.ico", "artifactName": "MasaHaNikud-Setup-${version}.${ext}"},
    "nsis": {"oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "createStartMenuShortcut": true, "shortcutName": "מסע הניקוד"}
  }
}
